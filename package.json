{
  "name": "ghost-pdf",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "vinext dev --port 5173",
    "build": "vinext build",
    "test:pdf": "node scripts/smoke-pdf.mjs",
    "test:office": "node scripts/smoke-office.mjs",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "build:next": "next build --webpack",
    "build:static": "node scripts/build-static.mjs",
    "test:regressions": "node --experimental-strip-types --test scripts/test-regressions.mjs",
    "test:conversions": "node scripts/test-conversions.mjs",
    "test:toolkit": "node scripts/test-toolkit.mjs",
    "test:safety": "node --experimental-strip-types --test scripts/test-file-safety.mjs",
    "test:security": "node scripts/test-security.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@cantoo/pdf-lib": "2.11.1",
    "@hookform/resolvers": "^5.7.1",
    "@libpdf/core": "0.5.3",
    "@shadcn/react": "^0.3.0",
    "@silurus/ooxml": "0.89.7",
    "@tesseract.js-data/ben": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "dompurify": "3.4.17",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "html-to-image": "1.11.13",
    "input-otp": "^1.4.2",
    "jszip": "^3.10.2",
    "lucide-react": "^1.31.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "pptxgenjs": "^4.0.1",
    "radix-ui": "^1.6.7",
    "react": "19.3.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "tesseract.js": "7.0.0",
    "vaul": "^1.1.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.66.0",
    "@cloudflare/workers-types": "5.20261101.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "@xmldom/xmldom": "^0.9.12",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "playwright": "1.64.1",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.4.0",
    "vite": "8.3.5",
    "wrangler": "4.156.0"
  },
  "type": "module",
  "overrides": {
    "image-size": "2.0.4",
    "sharp": "0.35.5",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    },
    "fflate": "0.8.3",
    "satori": "0.33.5"
  }
}
